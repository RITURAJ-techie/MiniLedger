{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
      "backgroundColor": "#09060E",
      "foregroundImage": "./assets/icon.png"
    },
      "predictiveBackGestureEnabled": false,
      "package": "com.riturajarena.miniledger"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "cb5fccfc-8f62-4518-ae8d-8ee530fcb7ae"
      }
    }
  }
}
